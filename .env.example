# =============================================================================
# WhatsApp AI Bot — configuración de ejemplo
# -----------------------------------------------------------------------------
# Generá un .env real con:  npm run setup
# El script crea secretos aleatorios y no sobreescribe un .env existente.
# =============================================================================

# --- Aplicación --------------------------------------------------------------
# docker-compose.yml fuerza NODE_ENV=production y LOG_PRETTY=false en el bot.
# En local, "development" + logs legibles es más cómodo para depurar.
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true
# 127.0.0.1 = solo esta máquina. Docker usa 0.0.0.0 dentro del contenedor.
HOST=127.0.0.1
PORT=4000
TRUST_PROXY=false
BODY_LIMIT=1mb
TIMEZONE=America/Bogota

# --- Base de datos -----------------------------------------------------------
# En Docker, docker-compose.yml lo sobreescribe a /app/data/bot.db.
DATABASE_PATH=./data/bot.db
EVENT_RETENTION_DAYS=14
JOB_RETENTION_DAYS=30
# Solo los usa scripts/backup.mjs.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# --- WAHA --------------------------------------------------------------------
# En Docker, docker-compose.yml lo sobreescribe a http://waha:3000.
WAHA_BASE_URL=http://localhost:3000
# URL que ve el usuario en el navegador (panel de WAHA / QR).
WAHA_PUBLIC_URL=http://localhost:3000
WAHA_SESSION=default
# Motor de WAHA: NOWEB (recomendado, sin navegador), WEBJS o GOWS.
WAHA_ENGINE=NOWEB
# NOWEB anuncia una versión de WhatsApp Web. "auto-web" obtiene la última al
# arrancar y evita Connection Failure si la versión incluida en la imagen quedó vieja.
WAHA_NOWEB_WA_VERSION=auto-web
WAHA_API_KEY=__GENERATE_48__
WAHA_WEBHOOK_HMAC_KEY=__GENERATE_64__
WAHA_REQUEST_TIMEOUT_MS=15000
SEND_SEEN=true
TYPING_INDICATOR=true
QUOTE_REPLIES=false

# Credenciales del dashboard de WAHA (solo las usa docker-compose.yml).
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=__GENERATE_24__

# --- Proveedor de IA ---------------------------------------------------------
# "ollama" = modelo local | "groq" = modelo en la nube (API compatible OpenAI).
# Cambiar a groq NO requiere Ollama ni descargar modelos.
AI_PROVIDER=groq

# --- Groq --------------------------------------------------------------------
# La key se lee SOLO del entorno. Nunca la subas al repositorio ni la hardcodees.
# La key que se compartió en el chat quedó expuesta: ROTALA en console.groq.com.
GROQ_API_KEY=__REEMPLAZAR_CON_TU_API_KEY_DE_GROQ__
# ID exacto según /models de tu cuenta (ej. openai/gpt-oss-20b).
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=60000
# Los modelos gpt-oss gastan tokens en razonamiento; dar margen a la salida.
GROQ_MAX_TOKENS=1024

# --- Ollama / IA local (se usa solo si AI_PROVIDER=ollama) --------------------
# En Docker, docker-compose.yml lo sobreescribe a http://ollama:11434.
OLLAMA_BASE_URL=http://localhost:11434
# Modelos sugeridos: llama3.2:3b (liviano), qwen2.5:7b (mejor español), llama3.1:8b.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
OLLAMA_TIMEOUT_MS=120000
OLLAMA_KEEP_ALIVE=30m

# --- Personalidad y comportamiento del bot ----------------------------------
BOT_NAME=Asistente
BOT_ENABLED=true
# Dejalo comentado para usar el prompt incluido en src/config.ts.
# SYSTEM_PROMPT=Sos un asistente conversacional por WhatsApp...
HISTORY_MAX_MESSAGES=30
HISTORY_MAX_CHARS=12000
PROMPT_MAX_MESSAGE_CHARS=4000
MAX_REPLY_CHARS=6000
IGNORE_GROUPS=true
# Lista separada por comas. Vacío = responder a cualquier chat directo.
# Acepta número con o sin formato, o el ID completo de WhatsApp.
# Ejemplo: ALLOWED_CHAT_IDS=5491111111111,5492222222222@c.us
ALLOWED_CHAT_IDS=
AI_FALLBACK_REPLY=Perdón, estoy teniendo un problema técnico en este momento. Probá de nuevo en unos minutos.

# --- Cotización de tatuajes -----------------------------------------------
# El número del tatuador se configura desde el panel (Conectar WhatsApp) y se
# guarda en la base. Esta variable es solo un respaldo para despliegues
# automatizados; si existe, el valor del panel tiene prioridad.
# Acepta 10 dígitos locales (3001234567), formato internacional
# (+57 300 123 4567) o el ID completo (573001234567@c.us).
TATTOO_ARTIST_CHAT_ID=
TATTOO_ARTIST_NAME=tatuador
# Guía de respuestas que se inyecta en cada prompt y se relee cada minuto.
RESPONSE_GUIDE_PATH=./formato_respuestas.md
RESPONSE_GUIDE_MAX_CHARS=12000
# Horas que una consulta puede quedar pendiente antes de vencer.
QUOTE_REQUEST_TTL_HOURS=48

# --- Agenda de Notion -------------------------------------------------------
# El token y la base también se configuran desde el panel. Estos valores son un
# respaldo para despliegues automatizados; el panel tiene prioridad.
# Token de la integración (empieza con ntn_). No lo subas al repositorio.
NOTION_API_KEY=
# ID o URL de la base de agenda. Compartí la base con la integración en Notion.
NOTION_DATABASE_ID=

# --- Resúmenes automáticos de contexto ---------------------------------------
SUMMARY_ENABLED=true
SUMMARY_TRIGGER_MESSAGES=30
SUMMARY_TRIGGER_CHARS=12000
SUMMARY_KEEP_RECENT_MESSAGES=8
SUMMARY_MAX_INPUT_CHARS=20000
SUMMARY_MAX_OUTPUT_TOKENS=400

# --- Cola durable ------------------------------------------------------------
QUEUE_POLL_INTERVAL_MS=500
JOB_MAX_ATTEMPTS=5

# --- Panel de administración (bot legado) -------------------------------------
ADMIN_ENABLED=true
# Reserva para APIs/automatizaciones (mínimo 16 caracteres). Ya no se usa para
# iniciar sesión en /admin: el panel usa usuario + contraseña.
ADMIN_TOKEN=__GENERATE_48__
# Usuario inicial del panel. Solo se crea si la tabla de usuarios está vacía.
# Si no se define ADMIN_PASSWORD, se usa ADMIN_TOKEN como contraseña inicial.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=__CAMBIAR_PASSWORD_LARGO_Y_SEGURO__

# =============================================================================
# PLATAFORMA MULTIUSUARIO (src/platform)  —  despliegue web
# -----------------------------------------------------------------------------
# Copiar estos valores al entorno del proveedor (Railway/Render/Fly/Vercel+...)
# o a un .env local. NUNCA subir el .env real al repositorio.
# IMPORTANTE: la cadena de conexión real apareció en un mensaje; ROTALA en Neon
# antes de desplegar y usá la nueva credencial acá.
# =============================================================================

# --- Neon PostgreSQL ----------------------------------------------------------
# Formato con pooler: postgresql://USUARIO:CONTRASEÑA@HOST-POOLER.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DB_POOL_MAX=10
DB_SSL=true
DB_CONNECTION_TIMEOUT_MS=15000

# --- Aplicación ---------------------------------------------------------------
HOST=0.0.0.0
PORT=4000
TRUST_PROXY=true
APP_BASE_URL=https://TU-DOMINIO.com
LOG_LEVEL=info

# --- WAHA (token de administrador) -------------------------------------------
# URL interna de WAHA alcanzable por la API (en Docker: http://waha:3000).
WAHA_BASE_URL=http://localhost:3000
# Token de administrador de WAHA. Se usa para crear/borrar sesiones y pedir el QR.
# Se envía como cabecera X-Api-Key. NUNCA hardcodearlo en el código.
WAHA_ADMIN_API_KEY=__REEMPLAZAR_CON_TOKEN_ADMIN_DE_WAHA__
WAHA_REQUEST_TIMEOUT_MS=15000

# --- Sesiones web -------------------------------------------------------------
# Pepper para hacer hash de los tokens de sesión (distinto de las contraseñas).
SESSION_SECRET=__GENERAR_32_CARACTERES_ALEATORIOS__
SESSION_TTL_HOURS=168
# true en producción (requiere HTTPS). false solo en desarrollo local.
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_NAME=wabm_session

# --- Cuenta administradora (sembrada en el primer arranque) -------------------
ADMIN_EMAIL=admin@TU-DOMINIO.com
ADMIN_PASSWORD=__CAMBIAR_PASSWORD_LARGO_Y_SEGURO__
ADMIN_FULL_NAME=Administrador
# Registro cerrado: solo el administrador crea usuarios desde el panel.
ALLOW_PUBLIC_REGISTRATION=false

# --- API keys por proyecto ----------------------------------------------------
API_KEY_PREFIX=wbp

# --- Integración del motor multiusuario (worker por bot) ----------------------
# La plataforma recibe TODOS los webhooks de WAHA, resuelve la sesión y delega
# en el motor del bot dueño de esa sesión. La sesión legada se reenvía al bot.
PLATFORM_BASE_URL=http://localhost:4001
PLATFORM_WEBHOOK_HMAC_KEY=__IGUAL_QUE_WAHA_WEBHOOK_HMAC_KEY__
# El bot legado reenvía aquí las sesiones que no son la suya.
PLATFORM_WEBHOOK_URL=http://platform:4001/webhook
LEGACY_SESSION_NAME=default
LEGACY_WEBHOOK_URL=http://bot:4000
ENGINE_DATA_DIR=./data/bots
ENGINE_POLL_INTERVAL_MS=500
USAGE_EVENT_RETENTION_DAYS=90

BODY_LIMIT=256kb
