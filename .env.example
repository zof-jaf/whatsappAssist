# =============================================================================
# WhatsApp AI Bot — configuración de ejemplo
# -----------------------------------------------------------------------------
# Generá un .env real con:  npm run setup
# El script crea secretos aleatorios y no sobreescribe un .env existente.
# =============================================================================

# --- Aplicación --------------------------------------------------------------
# docker-compose.yml fuerza NODE_ENV=production y LOG_PRETTY=false en el bot.
# En local, "development" + logs legibles es más cómodo para depurar.
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true
# 127.0.0.1 = solo esta máquina. Docker usa 0.0.0.0 dentro del contenedor.
HOST=127.0.0.1
PORT=4000
TRUST_PROXY=false
BODY_LIMIT=1mb
TIMEZONE=America/Bogota

# --- Base de datos -----------------------------------------------------------
# En Docker, docker-compose.yml lo sobreescribe a /app/data/bot.db.
DATABASE_PATH=./data/bot.db
EVENT_RETENTION_DAYS=14
JOB_RETENTION_DAYS=30
# Solo los usa scripts/backup.mjs.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# --- WAHA --------------------------------------------------------------------
# En Docker, docker-compose.yml lo sobreescribe a http://waha:3000.
WAHA_BASE_URL=http://localhost:3000
# URL que ve el usuario en el navegador (panel de WAHA / QR).
WAHA_PUBLIC_URL=http://localhost:3000
WAHA_SESSION=default
# Motor de WAHA: NOWEB (recomendado, sin navegador), WEBJS o GOWS.
WAHA_ENGINE=NOWEB
# NOWEB anuncia una versión de WhatsApp Web. "auto-web" obtiene la última al
# arrancar y evita Connection Failure si la versión incluida en la imagen quedó vieja.
WAHA_NOWEB_WA_VERSION=auto-web
WAHA_API_KEY=__GENERATE_48__
WAHA_WEBHOOK_HMAC_KEY=__GENERATE_64__
WAHA_REQUEST_TIMEOUT_MS=15000
SEND_SEEN=true
TYPING_INDICATOR=true
QUOTE_REPLIES=false

# Credenciales del dashboard de WAHA (solo las usa docker-compose.yml).
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=__GENERATE_24__

# --- Ollama / IA local -------------------------------------------------------
# En Docker, docker-compose.yml lo sobreescribe a http://ollama:11434.
OLLAMA_BASE_URL=http://localhost:11434
# Modelos sugeridos: llama3.2:3b (liviano), qwen2.5:7b (mejor español), llama3.1:8b.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
OLLAMA_TIMEOUT_MS=120000
OLLAMA_KEEP_ALIVE=30m

# --- Personalidad y comportamiento del bot ----------------------------------
BOT_NAME=Asistente
BOT_ENABLED=true
# Dejalo comentado para usar el prompt incluido en src/config.ts.
# SYSTEM_PROMPT=Sos un asistente conversacional por WhatsApp...
HISTORY_MAX_MESSAGES=30
HISTORY_MAX_CHARS=12000
PROMPT_MAX_MESSAGE_CHARS=4000
MAX_REPLY_CHARS=6000
IGNORE_GROUPS=true
# Lista separada por comas. Vacío = responder a cualquier chat directo.
# Acepta número con o sin formato, o el ID completo de WhatsApp.
# Ejemplo: ALLOWED_CHAT_IDS=5491111111111,5492222222222@c.us
ALLOWED_CHAT_IDS=
AI_FALLBACK_REPLY=Perdón, estoy teniendo un problema técnico en este momento. Probá de nuevo en unos minutos.

# --- Cotización de tatuajes -----------------------------------------------
# El número del tatuador se configura desde el panel (Conectar WhatsApp) y se
# guarda en la base. Esta variable es solo un respaldo para despliegues
# automatizados; si existe, el valor del panel tiene prioridad.
# Acepta 10 dígitos locales (3001234567), formato internacional
# (+57 300 123 4567) o el ID completo (573001234567@c.us).
TATTOO_ARTIST_CHAT_ID=
TATTOO_ARTIST_NAME=tatuador
# Guía de respuestas que se inyecta en cada prompt y se relee cada minuto.
RESPONSE_GUIDE_PATH=./formato_respuestas.md
RESPONSE_GUIDE_MAX_CHARS=12000
# Horas que una consulta puede quedar pendiente antes de vencer.
QUOTE_REQUEST_TTL_HOURS=48

# --- Agenda de Notion -------------------------------------------------------
# El token y la base también se configuran desde el panel. Estos valores son un
# respaldo para despliegues automatizados; el panel tiene prioridad.
# Token de la integración (empieza con ntn_). No lo subas al repositorio.
NOTION_API_KEY=
# ID o URL de la base de agenda. Compartí la base con la integración en Notion.
NOTION_DATABASE_ID=

# --- Resúmenes automáticos de contexto ---------------------------------------
SUMMARY_ENABLED=true
SUMMARY_TRIGGER_MESSAGES=30
SUMMARY_TRIGGER_CHARS=12000
SUMMARY_KEEP_RECENT_MESSAGES=8
SUMMARY_MAX_INPUT_CHARS=20000
SUMMARY_MAX_OUTPUT_TOKENS=400

# --- Cola durable ------------------------------------------------------------
QUEUE_POLL_INTERVAL_MS=500
JOB_MAX_ATTEMPTS=5

# --- Panel de administración -------------------------------------------------
ADMIN_ENABLED=true
# Mínimo 16 caracteres. El panel lo pide al ingresar en /admin.
ADMIN_TOKEN=__GENERATE_48__
